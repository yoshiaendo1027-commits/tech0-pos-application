# --- ローカル開発（SQLite）を使う場合 ---
# 下の行の先頭の # を外すと、SQLiteが使われます。
# DATABASE_URL=sqlite:///./pos.db

# --- Azure Database for MySQL を使う場合 ---
# DATABASE_URL は書かないでください（書くと、こちらが優先されます）。
# 実際の値は .env にだけ書き、この見本には書かないこと。
DB_HOST=gen12-mysql-pos.mysql.database.azure.com
DB_USER=tech0
DB_PASSWORD='ここにパスワード'
DB_NAME=pos_andy